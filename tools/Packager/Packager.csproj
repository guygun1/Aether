<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packages a self-contained Aether publish for Linux and macOS (runs on any OS).
    Commands: "linux|mac <publishDir> <out.tar.gz> <version>", "clean <dir>", "list <dir>...", "collect <dest> <dir>...".
    Used by the "Package ..." run configurations in .aether/runConfigurations (see docs/BUILDING.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
