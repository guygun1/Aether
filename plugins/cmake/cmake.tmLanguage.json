{
  "name": "CMake",
  "scopeName": "source.cmake",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#variables" },
    {
      "match": "(?i)\\b(if|elseif|else|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|return|break|continue|block|endblock)\\b(?=\\s*\\()",
      "name": "keyword.control.cmake"
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.cmake" } }
    },
    {
      "match": "\\b(AND|OR|NOT|DEFINED|EQUAL|LESS|GREATER|STREQUAL|MATCHES|VERSION_LESS|VERSION_GREATER|VERSION_EQUAL|EXISTS|IS_DIRECTORY|TARGET|COMMAND|IN_LIST)\\b",
      "name": "keyword.operator.cmake"
    },
    {
      "match": "\\b(PUBLIC|PRIVATE|INTERFACE|STATIC|SHARED|MODULE|OBJECT|REQUIRED|COMPONENTS|CONFIG|QUIET|LANGUAGES|VERSION|DEPENDS|WORKING_DIRECTORY|CACHE|FORCE|PARENT_SCOPE|TARGETS|DESTINATION|FILES|DIRECTORY|GLOB|GLOB_RECURSE|APPEND|ON|OFF|TRUE|FALSE|YES|NO)\\b",
      "name": "constant.language.cmake"
    },
    { "match": "\\b(CMAKE|PROJECT)_[A-Z0-9_]+\\b", "name": "variable.other.constant.cmake" },
    { "match": "\\b[0-9]+(\\.[0-9]+)*\\b", "name": "constant.numeric.cmake" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "#\\[(=*)\\[", "end": "\\]\\1\\]", "name": "comment.block.cmake" },
        { "match": "#.*$", "name": "comment.line.number-sign.cmake" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"", "end": "\"", "name": "string.quoted.double.cmake",
          "patterns": [ { "match": "\\\\.", "name": "constant.character.escape.cmake" }, { "include": "#variables" } ]
        },
        { "begin": "\\[(=*)\\[", "end": "\\]\\1\\]", "name": "string.quoted.other.cmake" }
      ]
    },
    "variables": {
      "patterns": [
        { "begin": "\\$(ENV|CACHE)?\\{", "end": "\\}", "name": "variable.other.cmake", "patterns": [ { "include": "#variables" } ] },
        { "match": "\\$<[^>]*>", "name": "support.function.generator-expression.cmake" }
      ]
    }
  }
}
