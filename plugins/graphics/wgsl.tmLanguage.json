{
  "name": "WGSL",
  "scopeName": "source.wgsl",
  "patterns": [
    { "begin": "/\\*", "end": "\\*/", "name": "comment.block.wgsl" },
    { "match": "//.*$", "name": "comment.line.double-slash.wgsl" },
    { "match": "@[A-Za-z_]+", "name": "meta.attribute.wgsl" },
    {
      "match": "\\b(fn|let|var|const|override|struct|alias|return|if|else|loop|for|while|break|continue|switch|case|default|discard|enable|requires|diagnostic)\\b",
      "name": "keyword.control.wgsl"
    },
    {
      "match": "\\b(bool|i32|u32|f32|f16|vec[234][fhiu]?|mat[234]x[234][fh]?|array|ptr|atomic|sampler|sampler_comparison|texture_[a-z0-9_]+|function|private|workgroup|uniform|storage|read|write|read_write)\\b",
      "name": "storage.type.wgsl"
    },
    { "match": "\\b(true|false)\\b", "name": "constant.language.wgsl" },
    { "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?)[iufh]?\\b", "name": "constant.numeric.wgsl" },
    { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.wgsl" } } }
  ]
}
