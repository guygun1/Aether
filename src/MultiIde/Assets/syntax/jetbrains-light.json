{
  "name": "jetbrains-light",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.triple-slash",
        "comment.line.double-slash.documentation",
        "comment.block.javadoc",
        "comment.line.double-slash.doc"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "constant.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.sizeof",
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "keyword.operator.borrow.and",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#0037A6"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#1750EB"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#00627A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "support.class",
        "support.type",
        "storage.type.cs",
        "storage.type.java",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "entity.name.variable.field",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#871094",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.attribute",
        "entity.other.attribute-name",
        "punctuation.definition.attribute",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#00627A"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.object",
        "variable.other"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#007E8A"
      }
    },
    {
      "scope": [
        "entity.name.lifetime",
        "storage.modifier.lifetime",
        "punctuation.definition.lifetime"
      ],
      "settings": {
        "foreground": "#20999D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F50000"
      }
    }
  ]
}
