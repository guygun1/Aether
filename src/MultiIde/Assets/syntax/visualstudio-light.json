{
  "name": "visualstudio-light",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.triple-slash",
        "comment.line.double-slash.documentation",
        "comment.block.javadoc",
        "comment.line.double-slash.doc"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "constant.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.sizeof",
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "keyword.operator.borrow.and",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#8F08C4"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#B776FB"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#74531F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "support.class",
        "support.type",
        "storage.type.cs",
        "storage.type.java",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#2B91AF"
      }
    },
    {
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "entity.name.variable.field",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "meta.attribute",
        "entity.other.attribute-name",
        "punctuation.definition.attribute",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#2B91AF"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#8A1BFF"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.object",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1F377F"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1F377F"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#2B91AF"
      }
    },
    {
      "scope": [
        "entity.name.lifetime",
        "storage.modifier.lifetime",
        "punctuation.definition.lifetime"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF0000"
      }
    }
  ]
}
