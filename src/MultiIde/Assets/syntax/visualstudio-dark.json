{
  "name": "visualstudio-dark",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#57A64A"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.triple-slash",
        "comment.line.double-slash.documentation",
        "comment.block.javadoc",
        "comment.line.double-slash.doc"
      ],
      "settings": {
        "foreground": "#608B4E"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "constant.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.sizeof",
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "keyword.operator.borrow.and",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#D8A0DF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#B4B4B4"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D69D85"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#FFD68F"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "support.class",
        "support.type",
        "storage.type.cs",
        "storage.type.java",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "entity.name.variable.field",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "scope": [
        "meta.attribute",
        "entity.other.attribute-name",
        "punctuation.definition.attribute",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#BEB7FF"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "keyword.preprocessor"
      ],
      "settings": {
        "foreground": "#9B9B9B"
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.object",
        "variable.other"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "scope": [
        "entity.name.lifetime",
        "storage.modifier.lifetime",
        "punctuation.definition.lifetime"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF6464"
      }
    }
  ]
}
