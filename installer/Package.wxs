<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!--
    Per-user install (no administrator prompt), like most modern IDE "user installers":
    files go to %LocalAppData%\Programs\Aether. Upgrades replace older versions in place.
  -->
  <Package Name="Aether"
           Manufacturer="Aether"
           Version="$(var.ProductVersion)"
           UpgradeCode="7C3E9B52-4F1A-4D6B-9E2C-5A8F1D0B6E31"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Aether is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AetherIcon" SourceFile="$(var.RepoRoot)\src\MultiIde\Assets\aether.ico" />
    <Property Id="ARPPRODUCTICON" Value="AetherIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Installer UI: welcome, install folder, progress, finish (with "Launch Aether"). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)\installer\License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Aether" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchAether" Directory="INSTALLFOLDER" ExeCommand="[INSTALLFOLDER]Aether.exe" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAether"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Aether" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Aether" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="CleanupFolders" />
    </Feature>

    <!-- Everything from the self-contained publish, plugins folder included. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B1A6E3F2-3C4D-4E5F-8A9B-0C1D2E3F4A51">
        <Shortcut Id="AetherStartMenu" Name="Aether" Description="Aether IDE"
                  Target="[INSTALLFOLDER]Aether.exe" WorkingDirectory="INSTALLFOLDER" Icon="AetherIcon" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C2B7F4A3-4D5E-4F60-9BAC-1D2E3F4A5B62">
        <Shortcut Id="AetherDesktop" Name="Aether" Description="Aether IDE"
                  Target="[INSTALLFOLDER]Aether.exe" WorkingDirectory="INSTALLFOLDER" Icon="AetherIcon" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Remove the install folders on uninstall (user settings in ~/.aether are kept). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Component Id="CleanupFolders" Guid="D3C8A5B4-5E6F-4071-ACBD-2E3F4A5B6C73">
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
