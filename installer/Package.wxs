<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!--
    Per-user install (no administrator prompt), like most modern IDE "user installers":
    files go to %LocalAppData%\Programs\Aether. Upgrades replace older versions in place.
  -->
  <Package Name="Aether"
           Manufacturer="Aether"
           Version="$(var.ProductVersion)"
           UpgradeCode="7C3E9B52-4F1A-4D6B-9E2C-5A8F1D0B6E31"
           Scope="perUser"
           Compressed="yes">

    <!-- Running the installer while Aether is installed updates it in place (same version included). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Aether is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Updates reuse the folder the previous version was installed to. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\Aether" Name="InstallFolder" Type="raw" />
    </Property>

    <!-- Wizard text: "install" normally, "update" when an existing install was found (see Strings.wxl). -->
    <Property Id="AETHER_WELCOME_TITLE" Value="Welcome to the Aether Setup Wizard" />
    <Property Id="AETHER_WELCOME_TEXT" Value="The Setup Wizard will install Aether on your computer. Click Next to continue or Cancel to exit." />
    <Property Id="AETHER_READY_TITLE" Value="Ready to install Aether" />
    <Property Id="AETHER_READY_TEXT" Value="Click Install to begin the installation. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." />
    <Property Id="AETHER_ACTION" Value="&amp;Install" />
    <SetProperty Id="AETHER_WELCOME_TITLE" Value="Update Aether" After="FindRelatedProducts" Sequence="ui" Condition="WIX_UPGRADE_DETECTED" />
    <SetProperty Id="AETHER_WELCOME_TEXT" Value="Aether is already installed. Setup will update it to version [ProductVersion] and keep your settings, plugins and projects. Close Aether, then click Next to continue." After="FindRelatedProducts" Sequence="ui" Condition="WIX_UPGRADE_DETECTED" />
    <SetProperty Id="AETHER_READY_TITLE" Value="Ready to update Aether" After="FindRelatedProducts" Sequence="ui" Condition="WIX_UPGRADE_DETECTED" />
    <SetProperty Id="AETHER_READY_TEXT" Value="Click Update to replace the installed version with [ProductVersion]. Click Cancel to exit the wizard." After="FindRelatedProducts" Sequence="ui" Condition="WIX_UPGRADE_DETECTED" />
    <SetProperty Id="AETHER_ACTION" Value="&amp;Update" After="FindRelatedProducts" Sequence="ui" Condition="WIX_UPGRADE_DETECTED" />

    <Icon Id="AetherIcon" SourceFile="$(var.RepoRoot)\src\MultiIde\Assets\aether.ico" />
    <Property Id="ARPPRODUCTICON" Value="AetherIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Installer UI: welcome, install folder, progress, finish (with "Launch Aether"). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)\installer\License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Aether" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchAether" Directory="INSTALLFOLDER" ExeCommand="[INSTALLFOLDER]Aether.exe" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAether"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <!-- Updating skips the license and folder pages: Welcome → Ready to update. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="10" Condition="WIX_UPGRADE_DETECTED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="10" Condition="WIX_UPGRADE_DETECTED" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Aether" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Aether" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="CleanupFolders" />
    </Feature>

    <!-- Everything from the self-contained publish, plugins folder included. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B1A6E3F2-3C4D-4E5F-8A9B-0C1D2E3F4A51">
        <Shortcut Id="AetherStartMenu" Name="Aether" Description="Aether IDE"
                  Target="[INSTALLFOLDER]Aether.exe" WorkingDirectory="INSTALLFOLDER" Icon="AetherIcon" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C2B7F4A3-4D5E-4F60-9BAC-1D2E3F4A5B62">
        <Shortcut Id="AetherDesktop" Name="Aether" Description="Aether IDE"
                  Target="[INSTALLFOLDER]Aether.exe" WorkingDirectory="INSTALLFOLDER" Icon="AetherIcon" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Remove the install folders on uninstall (user settings in ~/.aether are kept). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Component Id="CleanupFolders" Guid="D3C8A5B4-5E6F-4071-ACBD-2E3F4A5B6C73">
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Aether" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
