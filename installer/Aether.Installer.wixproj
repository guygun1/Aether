<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Builds Aether-<version>-x64.msi from a self-contained publish.
    In Aether, run the "Build MSI Installer" configuration (it runs "Publish Aether" first), or:
      dotnet build installer\Aether.Installer.wixproj -c Release -p:PublishDir=<path to publish>
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <OutputName>Aether-$(ProductVersion)-x64</OutputName>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion);RepoRoot=$(MSBuildThisFileDirectory)..</DefineConstants>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer\</OutputPath>
    <!-- Per-user installs keep files under %LocalAppData%; these ICEs assume per-machine layout. -->
    <!-- ICE61: same-version upgrades are intentional so rebuilt installers update in place. -->
    <SuppressIces>ICE38;ICE61;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
  <!-- Strings.wxl makes WiX write to an en-US subfolder; keep the .msi at artifacts\installer\. -->
  <Target Name="FlattenCultureOutput" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)en-US\$(OutputName).msi" DestinationFolder="$(OutputPath)" />
    <RemoveDir Directories="$(OutputPath)en-US" />
  </Target>
</Project>
